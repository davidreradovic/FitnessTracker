<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_workout_type">

    <fragment
        android:id="@+id/nav_workout_type"
        android:name="com.example.fitnesstracker.fragments.WorkoutTypeFragment"
        android:label="Workout Type"
        tools:layout="@layout/fragment_workout_type">
        <action
            android:id="@+id/action_nav_workout_type_to_nav_tracking"
            app:destination="@id/nav_tracking" />
    </fragment>

    <fragment
        android:id="@+id/nav_tracking"
        android:name="com.example.fitnesstracker.fragments.TrackingFragment"
        android:label="Tracking"
        tools:layout="@layout/fragment_tracking">
        <argument
            android:name="activityType"
            android:defaultValue="Running"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.fitnesstracker.fragments.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_nav_history_to_workoutDetailFragment"
            app:destination="@id/workoutDetailFragment" />
        <argument
            android:name="selectedDate"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.example.fitnesstracker.fragments.WorkoutDetailFragment"
        android:label="Workout Details"
        tools:layout="@layout/fragment_workout_detail">
        <argument
            android:name="workout"
            app:argType="com.example.fitnesstracker.db.entities.Workout" />
    </fragment>

    <fragment
        android:id="@+id/nav_statistics"
        android:name="com.example.fitnesstracker.fragments.StatisticsFragment"
        android:label="Statistics"
        tools:layout="@layout/fragment_statistics">
        <action
            android:id="@+id/action_nav_statistics_to_nav_history"
            app:destination="@id/nav_history" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.fitnesstracker.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_placeholder" />
</navigation>