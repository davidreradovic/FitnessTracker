<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dan 1: Odaberi vježbe"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etSearchExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pretraži vježbe..."
        android:textColor="@color/white"
        android:textColorHint="@color/gray_text"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDayTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnNextDay"
        app:layout_constraintTop_toBottomOf="@+id/etSearchExercise" />

    <Button
        android:id="@+id/btnNextDay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SLEDEĆI DAN"
        android:backgroundTint="@color/blue_primary"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>